# Dev — hot reload Next.js
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json* ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY prisma ./prisma

RUN npm install

COPY frontend ./frontend

WORKDIR /app/frontend
EXPOSE 3000

CMD ["npm", "run", "dev"]
