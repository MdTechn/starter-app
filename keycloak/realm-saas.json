{
  "realm": "saas-realm",
  "enabled": true,
  "displayName": "SaaS Starter",
  "loginTheme": "saas-light",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "accessTokenLifespan": 3600,
  "accessTokenLifespanForImplicitFlow": 3600,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "clientSessionIdleTimeout": 3600,
  "clientSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Default application user",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "Administrator — includes account, broker and realm-management client roles",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": ["USER"],
          "client": {
            "account": [
              "view-profile",
              "view-applications",
              "view-consent",
              "manage-account",
              "manage-consent",
              "delete-account",
              "manage-account-links",
              "view-groups"
            ],
            "broker": ["read-token"],
            "realm-management": [
              "view-authorization",
              "query-groups",
              "manage-identity-providers",
              "view-clients",
              "view-events",
              "query-clients",
              "realm-admin",
              "view-users",
              "create-client",
              "manage-events",
              "manage-clients",
              "manage-users",
              "impersonation",
              "view-identity-providers",
              "query-realms",
              "query-users",
              "view-realm",
              "manage-authorization",
              "manage-realm"
            ]
          }
        }
      },
      {
        "name": "default-roles-saas-realm",
        "description": "${role_default-roles}",
        "composite": true,
        "clientRole": false,
        "containerId": "saas-realm",
        "composites": {
          "realm": ["USER"]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-saas-realm",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "saas-realm"
  },
  "clients": [
    {
      "clientId": "saas-web",
      "name": "SaaS Web (Next.js)",
      "enabled": true,
      "publicClient": false,
      "secret": "${env.AUTH_KEYCLOAK_SECRET:saas-web-secret-change-me}",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "identity-provider",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "identity_provider",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "avatar",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "avatar",
            "claim.name": "picture",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.GOOGLE_CLIENT_ID:}",
        "clientSecret": "${env.GOOGLE_CLIENT_SECRET:}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "useJwksUrl": "true",
        "guiOrder": "1"
      }
    },
    {
      "alias": "facebook",
      "displayName": "Facebook",
      "providerId": "facebook",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.FACEBOOK_CLIENT_ID:}",
        "clientSecret": "${env.FACEBOOK_CLIENT_SECRET:}",
        "defaultScope": "public_profile,email",
        "syncMode": "IMPORT",
        "guiOrder": "2"
      }
    },
    {
      "alias": "apple",
      "displayName": "Apple",
      "providerId": "apple",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.APPLE_CLIENT_ID:}",
        "clientSecret": "${env.APPLE_CLIENT_SECRET:}",
        "defaultScope": "name email",
        "syncMode": "IMPORT",
        "guiOrder": "3"
      }
    },
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "microsoft",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${env.MICROSOFT_CLIENT_ID:}",
        "clientSecret": "${env.MICROSOFT_CLIENT_SECRET:}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "guiOrder": "4"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-email",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "google-firstname",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "google-lastname",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "google-username",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "username"
      }
    },
    {
      "name": "google-avatar",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "picture",
        "user.attribute": "avatar"
      }
    },
    {
      "name": "google-role-user",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "role": "USER"
      }
    },
    {
      "name": "facebook-email",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "facebook-firstname",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "first_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "facebook-lastname",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "last_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "facebook-username",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "username"
      }
    },
    {
      "name": "facebook-avatar",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "picture.data.url",
        "user.attribute": "avatar"
      }
    },
    {
      "name": "facebook-role-user",
      "identityProviderAlias": "facebook",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "role": "USER"
      }
    },
    {
      "name": "apple-email",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "apple-firstname",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "apple-lastname",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "apple-username",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "username"
      }
    },
    {
      "name": "apple-role-user",
      "identityProviderAlias": "apple",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "role": "USER"
      }
    },
    {
      "name": "microsoft-email",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "email"
      }
    },
    {
      "name": "microsoft-firstname",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "given_name",
        "user.attribute": "firstName"
      }
    },
    {
      "name": "microsoft-lastname",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "family_name",
        "user.attribute": "lastName"
      }
    },
    {
      "name": "microsoft-username",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "email",
        "user.attribute": "username"
      }
    },
    {
      "name": "microsoft-avatar",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "claim": "picture",
        "user.attribute": "avatar"
      }
    },
    {
      "name": "microsoft-role-user",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
