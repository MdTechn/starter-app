{
  "name": "saas-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend & npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w @saas-starter/shared && npm run build -w backend && npm run build -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w backend && npm run lint -w @saas-starter/shared",
    "test": "npm run test -w backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\"",
    "prepare": "husky",
    "postinstall": "npm run build -w @saas-starter/shared && prisma generate --schema=prisma/schema.prisma",
    "db:up": "docker compose up -d postgres keycloak",
    "db:up:all": "docker compose up -d",
    "db:down": "docker compose down",
    "keycloak:bootstrap": "bash keycloak/bootstrap/bootstrap-keycloak.sh",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.20.0"
  }
}
