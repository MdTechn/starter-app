# cp .env.example .env
# Variables centralisées à la racine du monorepo (backend + frontend).

# =============================================================================
# Runtime
# =============================================================================
NODE_ENV=development
LOG_LEVEL=debug

# =============================================================================
# Frontend (Next.js — port 3000)
# =============================================================================
NEXT_PUBLIC_APP_NAME=SaaS Starter
NEXT_PUBLIC_API_URL=http://localhost:3001/api
FRONTEND_URL=http://localhost:3000

# =============================================================================
# White-label branding (config only — no code changes)
# =============================================================================
APP_NAME=SaaS Starter
COMPANY_NAME=SaaS Starter Inc.
APP_URL=http://localhost:3000
LOGO_URL=/branding/logo.svg
FAVICON_URL=/branding/favicon.svg
PRIMARY_COLOR=#3d9cf0
SECONDARY_COLOR=#1e3a5f
BRAND_THEME=light
BRAND_FONT="Segoe UI, system-ui, sans-serif"
ICON_URL=/branding/icon-192.svg
APPLE_TOUCH_ICON_URL=/branding/apple-touch-icon.svg
SUPPORT_EMAIL=support@example.com
SUPPORT_URL=http://localhost:3000
# META_DESCRIPTION=Custom SEO description

# Mirror for Next.js client bootstrap (optional aliases)
NEXT_PUBLIC_COMPANY_NAME=SaaS Starter Inc.
NEXT_PUBLIC_PRIMARY_COLOR=#3d9cf0
NEXT_PUBLIC_SECONDARY_COLOR=#1e3a5f
NEXT_PUBLIC_BRAND_THEME=light
NEXT_PUBLIC_LOGO_URL=/branding/logo.svg
NEXT_PUBLIC_FAVICON_URL=/branding/favicon.svg

# NextAuth (OIDC Keycloak)
# Générer : openssl rand -base64 32
AUTH_SECRET=dev-auth-secret-change-me-32chars-min
AUTH_KEYCLOAK_ID=saas-web
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8090/realms/saas-realm
# Public mirrors for client-side OIDC helpers (logout / diagnostics)
NEXT_PUBLIC_AUTH_KEYCLOAK_ID=saas-web
NEXT_PUBLIC_AUTH_KEYCLOAK_ISSUER=http://localhost:8090/realms/saas-realm

# =============================================================================
# Backend (NestJS — port 3001)
# =============================================================================
PORT=3001
API_URL=http://localhost:3001
API_PREFIX=api
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=saas
POSTGRES_PASSWORD=saas_dev_password
POSTGRES_DB=saas_starter
POSTGRES_PORT=5544

DATABASE_URL=postgresql://saas:saas_dev_password@localhost:5544/saas_starter?schema=public
# DATABASE_MIGRATE_URL=postgresql://saas:saas_dev_password@localhost:5544/saas_starter?schema=public

# =============================================================================
# Keycloak (IAM principal)
# =============================================================================
KEYCLOAK_ENABLED=true
KEYCLOAK_PORT=8090
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=saas-realm
KEYCLOAK_ISSUER=http://localhost:8090/realms/saas-realm
# Client API (validation JWT backend)
KEYCLOAK_CLIENT_ID=saas-web
KEYCLOAK_CLIENT_SECRET=saas-web-secret-change-me
# Audience attendue (souvent le client frontend OIDC)
KEYCLOAK_AUDIENCE=saas-web
# KEYCLOAK_JWKS_URI=http://localhost:8090/realms/saas-realm/protocol/openid-connect/certs
KEYCLOAK_ADMIN_URL=http://localhost:8090
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Login theme (white bg) — applied via npm run keycloak:bootstrap
KEYCLOAK_LOGIN_THEME=saas-light

# =============================================================================
# JWT interne (optionnel — non utilisé si Keycloak actif)
# =============================================================================
# JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# OAuth social (Keycloak Identity Brokering — Epic 3)
# Credentials are used by Keycloak only (not by NextAuth / NestJS directly).
# See docs/SOCIAL_LOGIN.md for Google / Facebook app setup + redirect URIs.
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Prepared (disabled in realm until configured)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# =============================================================================
# Stripe Billing (SaaS abonnement) — voir docs/STRIPE_BILLING.md
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_KEY=
# Alias accepté :
# STRIPE_PUBLISHABLE_KEY=
# Price IDs optionnels (sinon Checkout utilise price_data + recurring)
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?canceled=1
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing

# =============================================================================
# Mail (SMTP)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SaaS Starter <noreply@example.com>
# EMAIL_FROM=SaaS Starter <noreply@example.com>

# =============================================================================
# Storage (local | s3 | cloudinary stub)
# =============================================================================
STORAGE_DRIVER=local
# Alias: STORAGE_PATH (preferred) or STORAGE_LOCAL_PATH
STORAGE_PATH=uploads
STORAGE_LOCAL_PATH=uploads
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# S3 / MinIO (STORAGE_DRIVER=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=saas-starter
# S3_REGION=eu-west-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# Aliases AWS_* still accepted:
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cloudinary stub (STORAGE_DRIVER=cloudinary) — not implemented yet
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# =============================================================================
# Redis / Cache / Jobs
# =============================================================================
REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=saas:

CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_PREFIX=cache:

# BullMQ
# BULLMQ_CONCURRENCY=5

# =============================================================================
# Observability
# =============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=metrics
PROMETHEUS_APP_NAME=saas-starter-api

OTEL_ENABLED=false
OTEL_SERVICE_NAME=saas-starter-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

HTTP_TIMEOUT_MS=30000
HTTP_COMPRESSION=true
API_VERSION=1

# =============================================================================
# AI CMS (translate / rewrite) — docs/AI.md
# Keys stay server-side only. Prefer Groq free tier (HopMed-style) first.
# =============================================================================
AI_PROVIDER_PRIORITY=groq,gemini,openai
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=30000
# AI_MAX_INPUT_CHARS=12000
# AI_DAILY_TOKEN_QUOTA=100000
# AI_RATE_LIMIT=10
# AI_RATE_LIMIT_TTL_MS=60000
